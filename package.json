{
  "name": "karaoke-pro",
  "version": "0.1.0",
  "description": "Karaoke Pro — software profissional de karaokê (MVP)",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "app": "electron .",
    "web": "vite build && node server/standalone.mjs",
    "serve": "node server/standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dist": "vite build && npx --yes electron-builder --win"
  },
  "build": {
    "appId": "br.karaokepro.app",
    "productName": "Karaoke Pro",
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@fontsource-variable/unbounded": "^5.3.0",
    "adm-zip": "^0.6.1",
    "music-metadata": "^12.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
