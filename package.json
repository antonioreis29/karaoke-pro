{
  "name": "karaoke-pro",
  "version": "0.2.0",
  "description": "Karaoke Pro — software de karaokê para DJs, bares e eventos",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "app": "electron .",
    "web": "vite build && node server/standalone.mjs",
    "serve": "node server/standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dist": "vite build && electron-builder --win --publish never",
    "icon": "electron scripts/make-icon.cjs",
    "check": "tsc --noEmit && node --test tests/*.test.mjs && vite build"
  },
  "build": {
    "appId": "br.karaokepro.app",
    "productName": "Karaoke Pro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "antonioreis29",
        "repo": "karaoke-pro",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Karaoke Pro",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Karaoke-Pro-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/unbounded": "^5.3.0",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11",
    "music-metadata": "^12.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
